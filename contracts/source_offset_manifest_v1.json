{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pulsestream/source-offset-manifest/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "topic", "bronze_manifest_sha256", "source_snapshots", "ranges"],
  "properties": {
    "format": {"const": "PULSESTREAM_OFFSET_MANIFEST_V1"},
    "topic": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,249}$"},
    "bronze_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bronze_event", "contract_quarantine"],
      "properties": {
        "bronze_event": {"type": "string", "pattern": "^([a-f0-9]{64}|[1-9][0-9]{0,19})$"},
        "contract_quarantine": {"type": "string", "pattern": "^([a-f0-9]{64}|[1-9][0-9]{0,19})$"}
      }
    },
    "ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["partition", "start_offset", "end_offset"],
        "properties": {
          "partition": {"type": "integer", "minimum": 0},
          "start_offset": {"type": "integer", "minimum": 0},
          "end_offset": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}

